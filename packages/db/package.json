{
  "name": "@erp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "admin:transfer": "tsx scripts/admin-transfer.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts"
  },
  "dependencies": {
    "@erp/auth": "workspace:*",
    "@erp/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@erp/config-eslint": "workspace:*",
    "@erp/config-typescript": "workspace:*",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.0",
    "tsx": "4.23.1"
  }
}
