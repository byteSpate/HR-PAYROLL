enum LeaveAccrualBasis {
  PRO_RATED
  PER_EVENT
  EARNED
  NONE
}
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum LeaveSession {
  FIRST_HALF
  SECOND_HALF
}
model LeaveType {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String            @unique
  isPaid           Boolean           @default(true)
  annualQuota      Int
  carryForwardPct  Int               @default(0)
  maxConsecutive   Int?
  allowsBackdating Boolean           @default(false)
  eligibleFor      EmploymentType[]
  statutory        Boolean           @default(false)
  countsHolidays   Boolean           @default(false)
  accrualBasis     LeaveAccrualBasis @default(PRO_RATED)
  minServiceMonths Int               @default(0)
  maxAccrual       Int?
  allowsHalfDay    Boolean           @default(true)
  requests         LeaveRequest[]
  balances         LeaveBalance[]
}
model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  accrued     Float     @default(0)
  used        Float     @default(0)
  balance     Float     @default(0)
  @@unique([employeeId, leaveTypeId, year])
}
model LeaveRequest {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  startSession LeaveSession @default(FIRST_HALF)
  endSession   LeaveSession @default(SECOND_HALF)
  // Fixed when requested; later calendar changes do not alter a decision's charge.
  chargedDays  Float
  reason       String?
  status       LeaveStatus  @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime     @default(now())
  @@index([employeeId, startDate, endDate])
  @@index([status])
}
