enum AccessLevel {
  SUPER_ADMIN
  ADMIN
  STANDARD
}

enum Scope {
  OWN
  TEAM
  DEPARTMENT
  ALL
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  isActive            Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  // Identity for an account with no Employee row, which would otherwise show
  // as a raw email address. Staff names live on Employee (Plan 2).
  displayName         String?
  /// Packed "publicId:version".
  avatarUrl           String?
  // Exactly one SUPER_ADMIN is enforced by the one_super_admin partial unique
  // index, which Prisma cannot express; see the access_model migration.
  accessLevel         AccessLevel          @default(STANDARD)
  // Only STANDARD users hold a role; ADMIN and SUPER_ADMIN hold everything.
  roleId              String?
  role                Role?                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailChangeRequests EmailChangeRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  employee            Employee?
  notifications       Notification[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  key    String           @id
  label  String
  module String
  // Scopes the manifest declares for this permission; empty means plain on/off.
  scopes Scope[]
  roles  RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  // Null for an on/off permission.
  scope         Scope?
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Rotation replaces the row on every refresh, so `id` identifies a token
  // and nothing identifies a *session*; sessionId is carried forward onto the
  // replacement row, along with startedAt and userAgent.
  sessionId  String   @default(uuid())
  /// When the session began, not when this token was written.
  startedAt  DateTime @default(now())
  /// Bumped on every rotation.
  lastUsedAt DateTime @default(now())
  /// Frozen at login.
  userAgent  String?
  /// Updated on rotation, unlike userAgent.
  ipAddress  String?

  @@index([userId, sessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Changing the address an account signs in with. Two links, two inboxes:
/// approve from the current address, then confirm at the new one. Only then
/// does anything change — see auth.emailchange.ts.
model EmailChangeRequest {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail         String
  approveTokenHash String    @unique
  approvedAt       DateTime?
  confirmTokenHash String?   @unique
  completedAt      DateTime?
  cancelledAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([approveTokenHash])
  @@index([confirmTokenHash])
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  changedBy String?
  changedAt DateTime @default(now())
  // Only the fields that changed, not whole snapshots.
  before    Json?
  after     Json?
  note      String?

  @@index([entity, entityId, changedAt])
  @@index([entity, entityId])
  @@index([changedAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([deliveredAt, availableAt])
}

/// The outbound mail log. One row per send attempt, so nothing the system
/// mails can escape the log. `sentAt` set means SENT, `error` set means
/// FAILED, neither means SKIPPED — a boolean cannot tell a crashed dyno from a
/// clean success. The recipient is denormalised at send time: this log answers
/// where the mail actually went, not where a join to User would send it now.
model EmailDispatch {
  id        String    @id @default(uuid())
  to        String
  kind      String
  subject   String
  entity    String?
  entityId  String?
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([entity, entityId])
}
