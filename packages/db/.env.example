DATABASE_URL=postgresql://erp:erp@localhost:5433/erp

# Isolated database for tests (created by `pnpm db:test:prepare`); keeps test fixtures out of the dev data.
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test

# First super admin, created by db:seed only when no active SUPER_ADMIN exists.
# Every developer shares this dev login: admin@example.com / change-me-now. The password is public, so the
# seed refuses it when NODE_ENV=production; set a real one there and leave the change below at its default.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# Dev only: 'false' lets the shared password keep working instead of forcing a change at first sign-in.
SEED_ADMIN_MUST_CHANGE_PASSWORD=false
