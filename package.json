{
  "name": "erp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @erp/db db:generate",
    "db:deploy": "pnpm --filter @erp/db db:deploy",
    "db:seed": "pnpm --filter @erp/db db:seed",
    "db:test:prepare": "pnpm --filter @erp/db db:test:prepare",
    "services:up": "docker compose -f docker/compose.dev.yaml up -d --wait",
    "services:down": "docker compose -f docker/compose.dev.yaml down"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.10"
  }
}
