DATABASE_URL=postgresql://erp:erp@localhost:5433/erp
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Optional comma-separated CORS allowlist; defaults to CLIENT_ORIGIN.
CORS_ORIGINS=
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
APP_TIMEZONE=Asia/Dhaka
COMPANY_NAME=Byte Spate
COMPANY_ADDRESS=
# Optional file storage; set all three or none.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional mail. When SMTP_HOST is unset every send is recorded as SKIPPED
# and nothing is actually sent; set all five to send for real.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
